# =========================================================================
# PAQUETES NUGET (Paquetes restaurados automáticamente)
# =========================================================================
*.nuget.props
*.nuget.targets
# Carpeta de paquetes global si se configura a nivel de proyecto
packages/

# =========================================================================
# CONFIGURACIONES DE USUARIO Y LOCALES (Evita conflictos entre desarrolladores)
# =========================================================================
# Archivos de usuario de Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates

# Archivos de secreto de usuario de .NET (User Secrets)
secrets.json

# Archivos de configuración de lanzamiento local (con credenciales locales)
launchSettings.json

# =========================================================================
# HERRAMIENTAS Y EDITORES (Visual Studio, VS Code, JetBrains Rider)
# =========================================================================
# Carpetas de Visual Studio
.vs/

# Carpetas de VS Code
.vscode/
!.vscode/tasks.json
!.vscode/launch.json

# Carpetas de JetBrains Rider
.idea/
*.sln.iml

